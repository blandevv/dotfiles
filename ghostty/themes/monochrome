# monochrome — grayscale variant of the gentleman theme
# Same structure as `gentleman`: swap by changing `theme = monochrome` in config.

background = 000000
foreground = f2f2f2
cursor-color = ffffff
selection-background = 2e2e2e
selection-foreground = f7f7f7

# Normal — luminance ramp keeps red/green/yellow distinguishable without hue
palette = 0=#121212
palette = 1=#5f5f5f
palette = 2=#8a8a8a
palette = 3=#a8a8a8
palette = 4=#6e6e6e
palette = 5=#9a9a9a
palette = 6=#7c7c7c
palette = 7=#c9c9c9

# Bright — every slot stays one step above its normal counterpart
palette = 8=#3f3f3f
palette = 9=#8f8f8f
palette = 10=#b8b8b8
palette = 11=#dedede
palette = 12=#9b9b9b
palette = 13=#cacaca
palette = 14=#a6a6a6
palette = 15=#f2f2f2
