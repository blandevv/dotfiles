{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logos/sans.png",
    "type": "kitty-icat",
    "height": 15,
    "padding": {
      "top": 1,
      "right": 0,
      "left": 0
    }
  },
  "display": {
    "separator": "  ",
    "color": "white"
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "╭─────────────────────────────────────────╮"
    },
    {
      "type": "custom",
      "key": "│                                         │"
    },
    {
      "type": "os",
      "key": "│  OS           ",
      "format": "{pretty-name>22}  │"
    },
    {
      "type": "command",
      "key": "│  Uptime       ",
      "shell": "/bin/bash",
      "text": "boot=$(sysctl -n kern.boottime | awk '{print $4}' | tr -d ,); now=$(date +%s); diff=$((now-boot)); d=$((diff/86400)); h=$(((diff%86400)/3600)); m=$(((diff%3600)/60)); if [ $d -gt 0 ]; then printf '%dd %dh %dm' $d $h $m; elif [ $h -gt 0 ]; then printf '%dh %dm' $h $m; else printf '%dm' $m; fi",
      "format": "{>22}  │"
    },
    {
      "type": "shell",
      "key": "│  Shell        ",
      "format": "{pretty-name>22}  │"
    },
    {
      "type": "packages",
      "key": "│  Packages     ",
      "format": "{all>22}  │"
    },
    {
      "type": "custom",
      "key": "│                                         │"
    },
    {
      "type": "command",
      "key": " ",
      "shell": "/bin/bash",
      "text": "echo '│                継続は力なり             │'",
      "format": "{1}"
    },
    {
      "type": "custom",
      "key": "╰─────────────────────────────────────────╯"
    },
    "break"
  ]
}
